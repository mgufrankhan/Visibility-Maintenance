# Single origin for the web app and both APIs. Terminate TLS in front of this
# container (customer reverse proxy or load balancer); see deploy/private/README.md.
server {
    listen 8080;
    server_name _;

    client_max_body_size 30m;
    server_tokens off;
    include /etc/nginx/snippets/security-headers.conf;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;

    location /api/v1/maintenance/ {
        proxy_pass http://${MAINTENANCE_UPSTREAM};
    }
    location /api/v1/identity/ {
        proxy_pass http://${PLATFORM_UPSTREAM};
    }
    location /api/v1/assets {
        proxy_pass http://${PLATFORM_UPSTREAM};
    }
    location = /api/v1/meta {
        proxy_pass http://${PLATFORM_UPSTREAM};
    }
    # Readiness is public for load balancers; /health/details requires credentials at the API.
    location /health/ {
        proxy_pass http://${MAINTENANCE_UPSTREAM};
    }

    root /usr/share/nginx/html;

    location = /service-worker.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
