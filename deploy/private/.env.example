# Copy to .env and edit. Contains no secrets; those live in ./secrets (init-secrets.sh).

# Public origin users reach (behind your TLS terminator). Also the token issuer.
PUBLIC_URL=https://maintenance.example.internal

# Host interface and port published by the web container. Bind to 127.0.0.1
# when a reverse proxy on the same host terminates TLS.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Neo stays off unless a later phase is configured; cloud inference is never
# enabled by this package. Values: disabled | private_only
NEO_INFERENCE_POLICY=disabled

# Simulated connectors are refused in production builds.
ALLOW_SIMULATED_CONNECTORS=false

# Issuer public keys for license verification (provided with your license).
LICENSE_PUBLIC_KEYS_PATH=./config/license-public-keys.json

# Image tags (override when installing a signed release bundle).
# VM_SERVER_IMAGE=visibility-maintenance/server:0.1.0
# VM_WEB_IMAGE=visibility-maintenance/web:0.1.0
